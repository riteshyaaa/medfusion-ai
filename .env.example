# MedScope AI — Environment Configuration
# Copy this file to .env, set the database URL, and replace placeholders.

# =============================================================================
# FRONTEND (artifacts/skin-ai)
# =============================================================================
PORT=3000
BASE_PATH=/

# API server (artifacts/api-server)
API_PORT=3001
API_HOST=127.0.0.1

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://medscope:change-this-password@localhost:5432/medscope_ai

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local storage path (development)
UPLOAD_DIR=uploads

# Object storage providers are not implemented in this phase. Uploaded images use
# private local disk storage; do not expose UPLOAD_DIR through a public web server.

# =============================================================================
# MEDICAL REPORT DOCUMENTS (upload, OCR, optional interpretation)
# =============================================================================
# Maximum accepted document size in bytes (default 20 MB). PDF, PNG, and JPEG are
# accepted; DICOM and other medical imaging formats are rejected.
DOCUMENT_MAX_FILE_SIZE=20971520
# OCR for scanned PDFs and document photographs uses tesseract.js locally.
OCR_ENABLED=true
OCR_LANG=eng
OCR_TIMEOUT_MS=60000
# Optional OCR language-data cache directory. Defaults to UPLOAD_DIR/.ocr-cache.
OCR_CACHE_DIR=
RATE_LIMIT_DOCUMENT=30
RATE_LIMIT_DOCUMENT_WINDOW_MS=60000

# =============================================================================
# OPTIONAL AI EXPLANATION PROVIDERS
# =============================================================================
# Providers are disabled by default. This integration explains an already
# completed, approved skin-model result; it never creates classifier scores.
AI_PROVIDER=none
# Allowed per-provider models are documented in docs/providers.md.
AI_MODEL=
# Optional image-capable model override used when a user consents to skin-image
# analysis (POST /api/predict with consentToExternalProcessing=true). Must come
# from the verified vision allowlist in docs/providers.md; if left empty,
# a verified per-provider default vision model is used.
AI_SKIN_VISION_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Optional HTTPS endpoint overrides. Defaults are the official provider endpoints.
OPENAI_BASE_URL=
GEMINI_BASE_URL=
NVIDIA_BASE_URL=
# Both server gates and per-request user consent are required before health
# classifier labels/scores can leave this application.
AI_DATA_SHARING_ENABLED=false
AI_HEALTH_DATA_TRANSFER_APPROVED=false
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_MAX_CONCURRENCY=2

# =============================================================================
# RESEARCH-ONLY MODEL INFERENCE (fails closed without verified artifacts)
# =============================================================================
# Skin research preview: a CPU CNN checkpoint trained on PAD-UFES-20 in this
# repository. Inference is research-only and runs through the local Python venv.
# Set SKIN_RESEARCH_INFERENCE_ENABLED=false to turn the preview off entirely.
SKIN_RESEARCH_INFERENCE_ENABLED=true
SKIN_MODEL_DIR=outputs/ml/skin/pad-ufes20-v1-cnn-baseline-20261015
SKIN_PYTHON=ml/skin/.venv/Scripts/python.exe
SKIN_INFER_TIMEOUT_MS=60000
# Symptom condition classifier: checksum-verified Bernoulli NB bundle exported
# from the "Disease Symptom Prediction" mirror dataset. Scores are not
# diagnosis probabilities.
SYMPTOM_MODEL_DIR=models/registry/symptoms/bernoulli-nb-v20261016
# Cardiac risk baseline: checksum-verified logistic-regression bundle trained on
# the UCI Cleveland subset. Outputs are uncalibrated, never clinical advice.
CARDIAC_MODEL_DIR=models/registry/cardiac/logreg-v20261016
# Cardiac research serving is DISABLED by default. Set to "true" only after
# reading the documented limitations; this is operator permission to serve a
# clearly-labelled research score, never clinical approval.
CARDIAC_RESEARCH_INFERENCE_ENABLED=false

# =============================================================================
# SECURITY
# =============================================================================
# CORS origins (comma-separated). The Vite proxy keeps local browser requests same-origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (requests per window)
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_PREDICT=30
RATE_LIMIT_PREDICT_WINDOW_MS=60000
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SYMPTOM=20
RATE_LIMIT_SYMPTOM_WINDOW_MS=60000
