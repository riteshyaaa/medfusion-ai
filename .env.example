# MedScope AI — Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# FRONTEND (artifacts/skin-ai)
# =============================================================================
PORT=3000
BASE_PATH=/

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://medscope:password@localhost:5432/medscope_ai

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here

# Demo password for development (change in production!)
DEMO_PASSWORD=medscope123

# =============================================================================
# AI / ML INTEGRATIONS (Optional)
# =============================================================================
# OpenAI API (for future AI features)
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-key-here
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Model serving endpoint (for self-hosted models)
# MODEL_SERVER_URL=http://localhost:8000
# MODEL_SERVER_API_KEY=your-model-server-key

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local storage path (development)
UPLOAD_DIR=./uploads

# S3-compatible storage (production)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=medscope-uploads
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=us-east-1

# =============================================================================
# SECURITY
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (requests per window)
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_PREDICT=30
RATE_LIMIT_PREDICT_WINDOW_MS=60000

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Metrics endpoint (Prometheus)
# METRICS_ENABLED=true
# METRICS_PORT=9090