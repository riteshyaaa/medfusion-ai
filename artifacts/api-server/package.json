{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "pnpm -r --filter @workspace/db run push",
    "db:studio": "pnpm -r --filter @workspace/db run studio"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.0",
    "uuid": "^10.0.0",
    "multer": "^1.4.5-lts.1",
    "@workspace/db": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/bcryptjs": "^2.4.0",
    "@types/cookie": "^0.6.0",
    "@types/multer": "^1.4.0",
    "@types/uuid": "^9.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}